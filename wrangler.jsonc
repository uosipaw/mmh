{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beads",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/beads/api/*",
      "/beads/studio*",
      "/images/mwah.gif",
      "/images/Your paragraph text.zip"
    ]
  },
  "vars": {
    "STORE_READY": "true",
    "PAYPAL_MODE": "live",
    "SHIPPING_CENTS": "900",
    "TAX_BPS": "700",
    "NOTIFICATIONS_START_AT": "2026-10-12T01:51:14.132Z"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mdsn-bead-orders"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
