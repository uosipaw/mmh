{
  // Editor Configuration - Beginner-Friendly Defaults
  "editor.fontSize": 14,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.formatOnSave": true,
  "editor.trimAutoWhitespace": true,
  "editor.wordWrap": "on",
  "editor.minimap.enabled": false,
  "editor.lineNumbers": "on",
  "editor.rulers": [80, 120],
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,

  // File Management - Prevent Accidents
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/.git": false,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/node_modules": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },

  // Git Integration - Easy Version Control
  "git.autofetch": true,
  "git.autorefresh": true,
  "git.confirmSync": true,
  "git.ignoreLimitWarning": true,
  "scm.alwaysShowRepositories": true,

  // Source Control - Protection
  "scm.repositories.visible": 1,
  "git.branchProtection": ["main", "master"],

  // Search - Helpful Defaults
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true
  },

  // Language-Specific Formatters
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },

  // Terminal - Better Visibility
  "terminal.integrated.fontSize": 12,
  "terminal.integrated.enableMultiLinePasteWarning": "auto",
  "terminal.integrated.confirmOnExit": "hasChildProcesses",

  // Appearance - Clean & Simple
  "workbench.startupEditor": "none",
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.tabCloseButton": "right",
  "window.zoomLevel": 0,

  // Extensions - Helpful Prompts
  "extensions.ignoreRecommendations": false,
  "extensions.recommendations": true,

  // Diff Editor - Clearer Changes
  "diffEditor.renderSideBySide": true,
  "diffEditor.wordWrap": "on",

  // Error Detection
  "problems.showCurrentInStatus": true,

  // Auto Commit Configuration
  "autoCommit.enable": true,
  "autoCommit.commitInterval": 3,
  "autoCommit.pushInterval": 5,
  "autoCommit.commitMessageFormat": "auto: ${changes} - ${date:yyyy-MM-dd HH:mm:ss}",
  "autoCommit.pullBeforePush": true,
  "autoCommit.pushOnCommit": true,
  "autoCommit.showStatusBarMessage": true,
  "workbench.editor.tabActionLocation": "right"
}
